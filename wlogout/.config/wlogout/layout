{
    "label" : "lock",
    "action" : "sh -c 'loginctl lock-session'",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "sh -c 'if command -v systemctl >/dev/null 2>&1; then systemctl hibernate; else loginctl hibernate; fi'",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "sh -c 'if command -v systemctl >/dev/null 2>&1; then systemctl poweroff; else loginctl poweroff; fi'",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "sh -c 'if command -v systemctl >/dev/null 2>&1; then systemctl suspend; else loginctl suspend; fi'",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "sh -c 'if command -v systemctl >/dev/null 2>&1; then systemctl reboot; else loginctl reboot; fi'",
    "text" : "Reboot",
    "keybind" : "r"
}
